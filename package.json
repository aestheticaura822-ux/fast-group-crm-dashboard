{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:website": "next dev --port 3000",
    "dev:dashboard": "next dev --port 3001",
    "dev:all": "concurrently \"npm run dev:website\" \"npm run dev:dashboard\"",
